{
  "uid": "capstone2-robot-shop",
  "title": "Robot Shop \u2014 RED metrics, availability and logs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Catalogue synthetic availability (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "robot_shop:availability:1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 2,
      "title": "Probe duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"robot-shop-availability\"}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error budget remaining (fraction)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "clamp_max(1 - (1 - robot_shop:availability:1h) / 0.01, 1)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Robot Shop logs (no Voting App collection)",
      "type": "logs",
      "datasource": {
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{namespace=\"robot-shop\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Service request rate \u2014 metric export required",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_total{service=~\"web|catalogue|cart|payment\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Service 5xx rate \u2014 metric export required",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_total{service=~\"web|catalogue|cart|payment\",status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Service p95 latency \u2014 metric export required",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le,service) (rate(http_server_request_duration_seconds_bucket{service=~\"web|catalogue|cart|payment\"}[5m])))"
        }
      ]
    }
  ]
}
